pipeline {
    agent any
     tools {
        nodejs 'node-24'
    }

    stages {
         stage('Check Node') {
            steps {
                sh 'node -v'
                sh 'npm -v'
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Build running'
            }
        }

        stage('Test') {
            steps {
                echo 'Tests running'
            }
        }
    }
}
