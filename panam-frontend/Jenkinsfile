pipeline {
  agent any

  stages {
    stage('Checkout') {
      steps {
        echo 'Code checked out'
      }
    }

    stage('Install') {
      steps {
        echo 'Installing dependencies'
        sh 'npm install'
      }
    }

    stage('Build') {
      steps {
        echo 'Building project'
        sh 'npm run build'
      }
    }
  }

  post {
    success {
      echo '✅ Build successful'
    }
    failure {
      echo '❌ Build failed'
    }
  }
}
