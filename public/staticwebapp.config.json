{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/static/media/*.{png,jpg,gif}", "/css/*", "/products/*", "/about/*", "/industries/*", "/news/*", "/account/*"]
  },
  "globalHeaders": {
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
  },
  "routes": [
    {
      "route": "/products",
      "rewrite": "/products/index.html"
    },
    {
      "route": "/about",
      "rewrite": "/about/index.html"
    },
    {
      "route": "/industries",
      "rewrite": "/industries/index.html"
    },
    {
      "route": "/news",
      "rewrite": "/news/index.html"
    },
    {
      "route": "/account",
      "rewrite": "/account/index.html"
    },
    {
      "route": "/index.html",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ]
}